# Copy this file to .env and uncomment/edit as needed.
# docker-compose.yml sets OLLAMA_BASE_URL automatically — only override it here
# if you're running the proxy directly with uvicorn (not via Docker).

# OLLAMA_BASE_URL=http://localhost:11434

# CHAT_MODEL=qwen2.5-coder:14b
# FIM_MODEL=qwen2.5-coder:7b

# CHAT_NUM_CTX=8192
# FIM_NUM_CTX=4096
# FIM_MAX_TOKENS=128

# PROXY_PORT=8080
# OLLAMA_TIMEOUT_SECONDS=120.0
