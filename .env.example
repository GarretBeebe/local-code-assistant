# Copy this file to .env and uncomment/edit as needed.
# docker-compose.yml sets OLLAMA_BASE_URL automatically — only override it here
# if you're running the proxy directly with uvicorn (not via Docker).

# OLLAMA_BASE_URL=http://localhost:11434

# Every chat request goes to CHAT_MODEL and every completion to FIM_MODEL,
# whatever model the client names.
# CHAT_MODEL=qwen2.5-coder:14b
# FIM_MODEL=qwen2.5-coder:7b

# CHAT_NUM_CTX=8192
# FIM_NUM_CTX=4096
# FIM_MAX_TOKENS=128            # ceiling: client max_tokens above this is capped
# FIM_DEFAULT_TEMPERATURE=0.1
# How long Ollama keeps the FIM model loaded after a request (a cold load takes ~26 s).
# Ollama duration string; use "-1m" (with a unit) to keep it loaded indefinitely.
# FIM_KEEP_ALIVE=2h

# PROXY_PORT=8080
# OLLAMA_TIMEOUT_SECONDS=120.0

# Bearer token required on all /v1/* routes. Omit to disable auth (localhost-only use).
# Generate with: openssl rand -hex 32
# PROXY_AUTH_TOKEN=
