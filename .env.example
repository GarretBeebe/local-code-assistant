# Copy this file to .env and uncomment/edit as needed.
# docker-compose.yml sets OLLAMA_BASE_URL automatically — only override it here
# if you're running the proxy directly with uvicorn (not via Docker).

# OLLAMA_BASE_URL=http://localhost:11434

# CHAT_NUM_CTX=8192
# FIM_NUM_CTX=4096
# FIM_MAX_TOKENS=128
# FIM_DEFAULT_TEMPERATURE=0.1

# PROXY_PORT=8080
# OLLAMA_TIMEOUT_SECONDS=120.0

# Bearer token required on all /v1/* routes. Omit to disable auth (localhost-only use).
# Generate with: openssl rand -hex 32
# PROXY_AUTH_TOKEN=

# Comma-separated list of allowed model names. Omit to allow any installed model.
# ALLOWED_MODELS=qwen2.5-coder:7b,qwen2.5-coder:14b

# RAG context injection (v4) — leave RAG_BASE_URL blank to disable
# RAG_BASE_URL=http://localhost:8000
# RAG_INTERNAL_TOKEN=
# RAG_CONTEXT_CHUNKS=3
# RAG_TIMEOUT_SECONDS=1.5
